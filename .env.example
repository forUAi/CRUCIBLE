# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#   $EDITOR .env
#   ./scripts/publish.sh
#
# GITHUB_TOKEN must be a classic personal access token with the `repo` scope,
# belonging to an account that has WRITE access to the destination repository.
#
# Note on the current blocker: the account `Vish01-rgb` authenticated via `gh`
# has `push: false` on forUAi/CRUCIBLE, so a token for that account will still
# be rejected with 403. The token needs to come from an account that owns or
# collaborates on forUAi/CRUCIBLE.
#
# Create at: https://github.com/settings/tokens  ->  "Tokens (classic)"
# Scope required: repo
GITHUB_TOKEN=

# Destination. Override only if publishing somewhere else.
GITHUB_REPO=forUAi/CRUCIBLE
GITHUB_BRANCH=main
